# Safe local/staging values only. Copy to .env.local; never commit the copy.
# Get these values from `supabase status` after running `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# The service-role value is server-only: never prefix it with NEXT_PUBLIC, commit a
# real value, or expose it to browser code. Never use production credentials here.
# Public, exact origin (no path). Use a separate staging host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
VEERA_RUNTIME_MODE=development
ADMIN_MFA_ENFORCEMENT=rollout
UPLOAD_SCANNER=unavailable
DEPLOYMENT_VERSION=local
MIGRATION_VERSION=local
STAGING_BACKUP_VERIFIED_AT=

# Server-only. Local placeholders must be replaced through the deployment secret manager.
EMAIL_PROVIDER=LOCAL
ALLOW_EXTERNAL_PROVIDERS=false
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
SCHEDULER_SECRET=
SCHEDULER_ACTOR_USER_ID=
RENTA_INTEGRATION_ENABLED=false
STARR365_INTEGRATION_ENABLED=false
