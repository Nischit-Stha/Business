# Safe local/staging values only. Copy to .env.local; never commit the copy.
# Get these values from `supabase status` after running `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Never put SUPABASE_SERVICE_ROLE_KEY, database passwords, access tokens,
# production credentials, customer PII, or document data in env files.

